  "ham_chan_quan_ngoc_hap_ky": {
    "note": "Đoạn văn giới thiệu/truyền thuyết về nguồn gốc sách Ngọc Hạp (Ông Hám Chân Quân) - văn xuôi, không phải bảng số liệu, chỉ trích đoạn mở đầu",
    "trich_doan": "Ông Hán Chân Quân thân người đài tác phúc thì nguyên, hay điều thương thương, làm chay, có người được phúc, có kẻ bị tội tai họa sinh ra họa phá tận con cháu. Vì thế Ông Hán Chân Quân sát trong bản án thiên tào thì thấy, chỉ vì những kẻ tầm thường không biết chọn ngày mà chung tiến Tổ Tiên không biết những ngày trong vòng 60 của lục Giáp tuần trong các vì sao hoặc ở địa phủ, hoặc ở nhân gian, dĩ chí phạm phải mà con cháu phạm phải chịu tai...",
    "source_pages": [
      66
    ]
  },
  "van_nien_12_thang_du_bao": {
    "note": "Bài văn vần dự báo thời tiết/mùa màng/dịch bệnh theo từng tháng âm lịch trong năm (dạng 'sấm truyền' nông lịch) - văn bản dài, mang tính chất dự báo thời tiết dân gian chung cho cả năm chứ không phải quy tắc chọn ngày cá nhân, nên chỉ trích đoạn đại diện thay vì toàn văn",
    "source_pages": [
